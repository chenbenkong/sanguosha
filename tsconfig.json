{
  // 架构治理批次：开启完整 strict（无任何单项放宽）。
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // 完整 strict：无任何单项放宽。
    // src/game/gameApi.ts 的 setter/回调签名已按真实类型收紧（原先 33 个 SetStateAction<any> + 24 个 any 函数），
    // 因此 noImplicitAny 不再需要关闭；tsc --noEmit --noImplicitAny true 全仓 0 错。
    "strict": true
  }
}
